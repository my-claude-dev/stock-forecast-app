# Copy this file to .env.local for local development, and set the same
# values as Environment Variables in the Vercel project settings for
# deployment. Never commit the real .env.local file (it is gitignored).

# Basic Auth credentials that gate access to the entire app (src/proxy.ts).
# Required — without both set, all requests are denied.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
